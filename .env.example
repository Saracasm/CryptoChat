# Copy to .env and fill in. Used by docker-compose.yml on the EC2 host --
# DATABASE_URL itself is NOT needed here for the Docker setup (compose
# builds it from POSTGRES_PASSWORD below); it's only for local/non-Docker
# runs against a manually-run Postgres.

# --- Required for docker-compose (EC2 deploy) ---
POSTGRES_PASSWORD=change-me
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Shared secret clients must send as the X-API-Key header (e.g. for /health).
API_KEY=change-me
# Signing secret for login JWTs. Use a long random string (32+ chars).
JWT_SECRET=change-me

# --- Optional ---
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
LOGFIRE_TOKEN=
# Comma-separated. Set to http://<ec2-public-ip>:3000 once you know it.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Local (non-Docker) dev only ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cryptochat
